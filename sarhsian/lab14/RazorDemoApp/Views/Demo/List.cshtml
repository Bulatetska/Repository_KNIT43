@model List<string>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Список країн — Лаб 14</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <main>
        <h2>Список країн</h2>

        @if (Model.Count == 0)
        {
            <p>Список країн порожній.</p>
        }
        else
        {
            <ul>
                @foreach (var country in Model)
                {
                    <li>@country</li>
                }
            </ul>
        }

        <p><a href="/demo/index">Повернутися на головну сторінку</a></p>
    </main>
</body>
</html>
