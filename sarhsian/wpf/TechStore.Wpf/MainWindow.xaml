<Window x:Class="TechStore.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TechStore — магазин техніки" Height="680" Width="1040"
        MinHeight="550" MinWidth="820" WindowStartupLocation="CenterScreen"
        Background="#F7F7F7" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,5,8,0" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="0,5,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TechStore" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Каталог товарів та оформлення замовлень" Foreground="#555555" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="330" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Каталог товарів" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Products}"
                             SelectedItem="{Binding SelectedProduct, Mode=TwoWay}"
                             BorderBrush="#CCCCCC" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,7">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ProductType}" Foreground="#555555" />
                                    <TextBlock Text="{Binding PriceText}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Margin="0,13,0,0">
                        <TextBlock Text="Характеристики" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedProduct.Specifications}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding SelectedProduct.AdditionalInformation}" TextWrapping="Wrap" Foreground="#555555" Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,11,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Кількість:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Width="65" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Додати до кошика" Command="{Binding AddCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Кошик" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,9" />
                    <ListBox Grid.Row="1" MinHeight="70" ItemsSource="{Binding CartLines}"
                             SelectedItem="{Binding SelectedCartLine, Mode=TwoWay}"
                             BorderBrush="#CCCCCC">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding QuantityText}" Foreground="#555555" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding LineTotalText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,7">
                        <Button Content="Видалити вибране" Command="{Binding RemoveCommand}" />
                        <Button Content="Очистити кошик" Command="{Binding ClearCommand}" />
                    </StackPanel>
                    <Grid Grid.Row="3" Margin="0,4,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Text="Кількість одиниць:" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ItemsCountText}" />
                        <TextBlock Grid.Row="1" Text="Без знижки:" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SubtotalText}" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="Знижка (%):" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" Width="62" />
                        </StackPanel>
                        <TextBlock Grid.Row="3" Text="До сплати:" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalText}" FontWeight="SemiBold" FontSize="16" />
                    </Grid>
                    <Button Grid.Row="4" Content="Оформити замовлення" Command="{Binding CheckoutCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,8" />
                    <TextBox Grid.Row="5" Text="{Binding ReceiptText, Mode=OneWay}" IsReadOnly="True"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             MinHeight="95" Background="#FAFAFA" />
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Margin="0,12,0,0" Foreground="#444444" TextWrapping="Wrap" />
    </Grid>
</Window>
