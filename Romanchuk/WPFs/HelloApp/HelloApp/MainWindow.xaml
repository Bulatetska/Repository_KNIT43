<Window x:Class="HelloApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HelloApp" xmlns:viewmodel="clr-namespace:HelloApp.ViewModel" d:DataContext="{d:DesignInstance Type=viewmodel:ApplicationViewModel}"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="grid1" >
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>
        <TextBlock  x:Name="tblock1" Grid.Row="1" Width="100" Height="30">Введіть своє ім'я</TextBlock>
        <TextBox x:Name="tbox1" Grid.Row="2" Width="100" Height="30" DataContext="{Binding NewName}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
        <Button x:Name="button1" Grid.Row="3" Width="100" Height="30" Content="Підтвердити" Command="{Binding AddCommand}"/>
        <TextBlock x:Name="tblock2" Grid.Row="4" Width="100" Height="30" DataContext="{Binding NewName}"  Text="{Binding NamePlusHello}"/>
    </Grid>
</Window>
