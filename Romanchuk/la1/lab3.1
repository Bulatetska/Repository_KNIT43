using System;
using System.Collections.Generic;

class Program {
    
    private class Hero
	{
		public string Name { get; set; }
		public int YearOfBirth { get; set; }
		public string Comics { get; set; }
	};
    
    private static readonly List<Hero> _heroes = new List<Hero>
	{
		new Hero
		{
			Name = "Superman",
			YearOfBirth = 1938,
			Comics = "Action Comics"
		},
		new Hero
		{
			Name = "Batman",
			YearOfBirth = 1938,
			Comics = "Detective Comics"
		},
		new Hero
		{
			Name = "Captain America",
			YearOfBirth = 1941,
			Comics = "Captain America Comics"
		},
		new Hero
		{
			Name = "Ironman",
			YearOfBirth = 1963,
			Comics = "Tales of Suspense"
		},
		new Hero
		{
			Name = "Spiderman",
			YearOfBirth = 1963,
			Comics = "Amazing Fantasy"
		}
	};

	static void Main() {
	    
	    //ex
		var heroNames = new List<string>();
		foreach (var hero in _heroes)
		{
			if (hero.Name.Contains("man"))
			{
				heroNames.Add(hero.Name);
			}
		}
		heroNames.Sort();
		foreach (var heroName in heroNames)
		{
			Console.WriteLine(heroName);
		}
		
		//1
		var heroNames_41 = new List<string>();
		foreach (var hero in _heroes)
		{
			if (hero.YearOfBirth == 1941)
			{
				heroNames_41.Add(hero.Name);
			}
		}
		Console.WriteLine("\nВ 1941:");
		
		foreach (var heroName in heroNames_41)
		{
			Console.WriteLine(heroName);
		}
		
		//2
		var comics = new List<string>();
		foreach (var hero in _heroes)
		{
			if (!comics.Contains(hero.Comics))
			{
				comics.Add(hero.Comics);
			}
		}
		comics.Sort();
		Console.WriteLine("\nКомікси:");
		
		foreach (var comicName in comics)
		{
			Console.WriteLine(comicName);
		}
		
		//3
        heroNames = new List<string>();
        var years = new List<int>();
        
		foreach (var hero in _heroes)
		{
			heroNames.Add(hero.Name);
            years.Add(hero.YearOfBirth);
		}
		
        for (int i = 0; i < years.Count; i++)
        {
            for (int j = i + 1; j < years.Count; j++)
            {
                if (years[i] > years[j])
                {
                    (heroNames[i], heroNames[j]) = (heroNames[j], heroNames[i]);
                    (years[i], years[j]) = (years[j], years[i]);
                    continue;
                }
            }
        }
        Console.WriteLine("\nІмена і дати:");
        for (int i = 0; i < years.Count; i++)
        {
            Console.WriteLine(heroNames[i] + " " + years[i]);
        }
	}
}
