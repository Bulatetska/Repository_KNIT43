@model Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="form-container">

    <span class="eyebrow">PRODUCT MANAGEMENT</span>
    <h1>Edit Product</h1>

    <form asp-action="Edit" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly"
             class="validation-summary"></div>

        <div class="form-group">
            <label asp-for="Name">Product Name</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description">Description</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"></textarea>
        </div>

        <div class="form-group">
            <label asp-for="Price">Price ($)</label>
            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="form-control" />
            <span asp-validation-for="Price" class="validation-error"></span>
        </div>

        <div class="form-group">
            <label asp-for="Stock">Stock Quantity</label>
            <input asp-for="Stock"
                   type="number"
                   class="form-control" />
            <span asp-validation-for="Stock" class="validation-error"></span>
        </div>

        <button type="submit" class="btn btn-primary btn-block">
            Save Changes
        </button>

        <a asp-action="List" class="cancel-link">
            Cancel
        </a>

    </form>

</div>