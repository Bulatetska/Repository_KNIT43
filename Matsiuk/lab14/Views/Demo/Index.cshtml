@{
    ViewData["Title"] = "Razor Demo";
}

<div class="container mt-4">
    <h1>@ViewData["Message"]</h1>

    <p class="lead">
        This page demonstrates Razor syntax in ASP.NET Core MVC.
    </p>

    <h2>Numbers from 1 to 5</h2>

    <ul>
        @for (var i = 1; i <= 5; i++)
        {
            <li>Number: @i</li>
        }
    </ul>

    <hr />

    @await Html.PartialAsync("_PartialView")
</div>
