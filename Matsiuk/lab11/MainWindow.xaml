<Window x:Class="LibraryMVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Manager"
        Height="500"
        Width="800"
        MinHeight="400"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Library Manager"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202A44"/>

            <TextBlock Text="Manage your book collection"
                       FontSize="14"
                       Foreground="#667085"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.4*"/>
            </Grid.ColumnDefinitions>

            <GroupBox Header="Books"
                      Grid.Column="0"
                      Padding="10"
                      Background="White">

                <ListBox ItemsSource="{Binding Books}"
                         SelectedItem="{Binding SelectedBook,
                             Mode=TwoWay}"
                         DisplayMemberPath="Title"
                         BorderThickness="0"
                         FontSize="15"
                         Padding="5"/>
            </GroupBox>

            <GroupBox Header="Book Details"
                      Grid.Column="2"
                      Padding="15"
                      Background="White">

                <StackPanel>
                    <TextBlock Text="Title"
                               Margin="0,0,0,5"/>

                    <TextBox Text="{Binding SelectedBook.Title,
                        UpdateSourceTrigger=PropertyChanged}"
                             Padding="8"
                             FontSize="14"/>

                    <TextBlock Text="Author"
                               Margin="0,15,0,5"/>

                    <TextBox Text="{Binding SelectedBook.Author,
                        UpdateSourceTrigger=PropertyChanged}"
                             Padding="8"
                             FontSize="14"/>

                    <TextBlock Text="Publication Year"
                               Margin="0,15,0,5"/>

                    <TextBox Text="{Binding SelectedBook.Year,
                        UpdateSourceTrigger=PropertyChanged,
                        ValidatesOnExceptions=True}"
                             Padding="8"
                             FontSize="14"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="Add Book"
                    Command="{Binding AddCommand}"
                    Padding="20,10"
                    Margin="0,0,10,0"
                    Background="#2457D6"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>

            <Button Content="Delete Book"
                    Command="{Binding DeleteCommand}"
                    Padding="20,10"
                    Background="#D92D20"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>