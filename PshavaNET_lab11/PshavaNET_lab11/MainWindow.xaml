<Window x:Class="PshavaNET_lab11.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Каталог книг — MVVM"
        Height="480"
        Width="850"
        MinHeight="400"
        MinWidth="700">

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1.3*"/>
        </Grid.ColumnDefinitions>

        <!-- Список книг -->
        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Books}"
                 SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                 Margin="0,0,12,0">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8"
                            Margin="3">

                        <StackPanel>
                            <TextBlock Text="{Binding Title}"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>

                            <TextBlock Margin="0,4,0,0">
                                <Run Text="Автор: "/>
                                <Run Text="{Binding Author}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Рік: "/>
                                <Run Text="{Binding Year}"/>
                            </TextBlock>
                        </StackPanel>

                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Поля редагування -->
        <StackPanel Grid.Column="1"
                    Margin="12,0,0,0">

            <TextBlock Text="Дані книги"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,0,0,18"/>

            <TextBlock Text="Назва книги"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding SelectedBook.Title,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Padding="6"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Автор"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding SelectedBook.Author,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=PropertyChanged}"
                     Padding="6"
                     Margin="0,0,0,14"/>

            <TextBlock Text="Рік видання"
                       Margin="0,0,0,5"/>

            <TextBox Text="{Binding SelectedBook.Year,
                                    Mode=TwoWay,
                                    UpdateSourceTrigger=LostFocus}"
                     Padding="6"
                     Margin="0,0,0,14"/>

            <!-- Кнопки керування -->
            <StackPanel Orientation="Horizontal"
                        Margin="0,8,0,0">

                <Button Content="Додати книгу"
                        Command="{Binding AddBookCommand}"
                        Padding="12,8"
                        Margin="0,0,10,0"/>

                <Button Content="Видалити книгу"
                        Command="{Binding RemoveBookCommand}"
                        CommandParameter="{Binding SelectedBook}"
                        Padding="12,8"/>

            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
