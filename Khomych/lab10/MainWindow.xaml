<Window x:Class="GreetingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Привітання"
        Height="300" Width="450"
        MinHeight="250" MinWidth="320"
        WindowStartupLocation="CenterScreen">

    <!-- Зовнішня сітка: пропорційні (*) рядки та стовпці,
         тому елементи масштабуються разом із розміром вікна -->
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Вміст у центральній клітинці; ширина розтягується з вікном -->
        <StackPanel Grid.Row="1" Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">

            <!-- 1. Інструкція для користувача -->
            <TextBlock Text="Введіть своє ім'я"
                       FontSize="16"
                       Margin="0,0,0,8"
                       HorizontalAlignment="Left"/>

            <!-- 2. Поле введення імені: двостороння прив'язка до UserName -->
            <TextBox x:Name="NameTextBox"
                     Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="16"
                     Padding="6,4"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,12"/>

            <!-- 3. Кнопка підтвердження (IsDefault — спрацьовує також на Enter) -->
            <Button x:Name="ConfirmButton"
                    Content="Підтвердити"
                    Click="ConfirmButton_Click"
                    IsDefault="True"
                    FontSize="16"
                    Padding="10,5"
                    HorizontalAlignment="Stretch"
                    Margin="0,0,0,12"/>

            <!-- 4. Повідомлення з результатом: прив'язка до Greeting -->
            <TextBlock x:Name="ResultTextBlock"
                       Text="{Binding Greeting}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="DarkGreen"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       HorizontalAlignment="Stretch"/>
        </StackPanel>
    </Grid>
</Window>
